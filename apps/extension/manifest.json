{
	"manifest_version": 3,
	"name": "BridgeHook",
	"description": "A permanent webhook URL for each localhost port. Forwards webhooks to your local server, queued while you are offline.",
	"version": "0.2.0",
	"permissions": ["storage", "notifications", "alarms"],
	"host_permissions": [
		"http://localhost/*",
		"https://relay.bridgehook.dev/*",
		"https://bridgehook-relay.halleluyaholudele.workers.dev/*"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"32": "icons/icon-32.png"
		}
	},
	"icons": {
		"32": "icons/icon-32.png",
		"128": "icons/icon-128.png"
	}
}
